# Flask 环境配置
FLASK_ENV=production

# Superset 密钥（用于会话加密，应该改为强密钥）
SUPERSET_SECRET_KEY=your-secret-key-change-me-in-production

# PostgreSQL 配置
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset_password_change_me

# Redis 配置（默认使用 Docker 服务名）
REDIS_HOST=redis
REDIS_PORT=6379

# Superset 初始管理员账户（可选）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@superset.local
