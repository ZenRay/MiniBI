# Flask 环境配置
FLASK_ENV=production

# Superset 密钥（用于会话加密，应该改为强密钥）
SUPERSET_SECRET_KEY=superset

# PostgreSQL 配置
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

# Redis 配置（默认使用 Docker 服务名）
REDIS_HOST=redis
REDIS_PORT=6379

# Superset 初始管理员账户（可选）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@superset.local

# Explicit Postgres DSN for Superset to avoid falling back to SQLite
# Use the psycopg2 driver (required by some Superset deployments)
SUPERSET__SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:superset@postgres:5432/superset

# Container runtime UID/GID and workdir for Superset (can be adjusted per host)
CONTAINER_UID=1000
CONTAINER_GID=1000
CONTAINER_USER=1000:1000
SUPERSET_WORKDIR=/app/superset_home
